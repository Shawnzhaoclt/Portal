{
  "schemaVersion": 1,
  "sharedDataRoot": "G:/Strategic Planning/Planning/stm_risk_data",
  "defaults": {
    "sourceSrid": 2264,
    "publicationBounds": [-81.15, 34.9, -80.45, 35.62],
    "maximumZoom": 16,
    "extent": 4096,
    "buffer": 64,
    "simplification": 1.0,
    "memoryLimit": "4GB",
    "temporaryDirectory": "${LOCALAPPDATA}/PortalManager/map-tiles/temp",
    "progressFile": "${LOCALAPPDATA}/PortalManager/map-tiles/progress.json",
    "workerCount": 3,
    "threadsPerWorker": 6,
    "engine": "tippecanoe",
    "fallbackEngine": "gdal",
    "tippecanoeExecutable": "vendor/tippecanoe/tippecanoe.exe",
    "tippecanoeThreads": "ALL_CPUS",
    "tippecanoeGroupWorkers": 3,
    "gdalThreads": "ALL_CPUS"
  },
  "sources": [
    {
      "id": "spatial-data-warehouse",
      "database": "${PORTAL_SHARED_DATA_ROOT}/databases_local/virt_sdw_01_sdw_spatial_warehouse.duckdb",
      "schema": "main",
      "sourceSrid": 2264,
      "includeAllSpatialTables": true,
      "propertiesByTable": {
        "MeckCountyDams_pt": ["Name", "Hazard_Status"],
        "StormStructure_pt": ["ITPIPE_ASSETID", "STRUCT_TYPE", "Active", "AssetID", "INVERT", "DEPTH"],
        "StormPipes_ln": ["ITPIPE_ASSETID", "PACP_Height", "Active", "AssetID", "US_ASSETID", "DS_ASSETID", "MATERIAL", "PACP_Material", "CONST_DATE"],
        "StormDrainage_ln": ["ITPIPE_ASSETID", "AssetID", "US_ASSETID", "DS_ASSETID"],
        "Ponds_py": ["PondName"],
        "SidewalkInventory_ln": ["SidewalkPresence", "AssetID", "StreetAssetID"],
        "BridgesCityInspected_pt": ["UNITID", "ConformingType", "Conforming"],
        "StreetsMapUptownAdopted_ln": ["Name"],
        "StreetsMapAdopted_ln": ["WHOLE_STRE", "Legend"],
        "CollectorStreets_ln": ["WHOLESTNAME", "CrossSection"],
        "StreetMaintenanceResponsibility_ln": ["WHOLESTNAME", "MaintainedBy"],
        "Road_ln": ["WHOLESTNAME", "THOROUGHFARETYPE"],
        "ImperviousSurfaceOther_py": ["LDPlanName", "Subtheme"],
        "LYNXBlueLine_ln": ["OBJECTID"],
        "LYNXRedLine_ln": ["OBJECTID"],
        "LYNXSilverLineAlignment_ln": ["OBJECTID"],
        "CityLYNXGoldLine_ln": ["OBJECTID"],
        "Railroad_ln": ["NAME"],
        "StormWaterEasements_pt": ["PID"],
        "StormWaterConservationEasements_py": ["Project"],
        "Buildings_py": ["Layer"],
        "ParcelJoin_py": ["FULL_ADDRESS", "houseno"],
        "StormWater311Requests_pt": ["ClassificationName", "Request_Type", "Status", "WO_ID"],
        "StormDrainageRepairProjects_pt": ["Address"],
        "StormWaterConstructionProjects_pt": ["ProjectName"],
        "StormWaterProjectStructure_pt": ["Status", "WO_Desc", "WO_ID", "Asset_ID"],
        "StormWaterProjectPipe_ln": ["Project_Name", "Status", "WO_Desc", "WO_ID", "Asset_ID"],
        "StormWaterProjectChannel_ln": ["Project_Name", "Status", "WO_Desc", "WO_ID", "Asset_ID"],
        "StormWaterProjectParcels_py": ["Construction_End", "Project_Name", "WO_ID", "RFC_Date", "WO_Desc", "Status", "Work_Type"],
        "StormWaterProjectAssignmentZones_py": ["SrPM", "Sr_Consult", "PM_Consult", "DESCR"],
        "RainGauges_pt": ["gage_type"],
        "StreamGauges_pt": ["gage_type"],
        "Streams_ln": ["Stream_Name"],
        "ImperviousSurfaceNSF_py": ["LDPlanName"],
        "ImperviousSurfaceSingleFamily_py": [],
        "Soils_py": ["DSL_NAME", "HYDRO_GROU", "FULLNAME"],
        "Topo_ln": ["Elev", "Interval"],
        "Subdivisions_py": ["ProjName", "AppStatus"],
        "LandDevelopment_ConstructionInspectors_py": ["NAME"],
        "LandDevelopment_EngineeringInspectors_py": ["NAME"],
        "LandDevelopment_ErosionControlCoordinators_py": ["NAME"],
        "LandDevelopmentInspectorAreas_py": ["AREANAME"],
        "LandDevelopment_PlanReviewCoordinators": ["NAME"],
        "UtilitiesCoordinationWorkZones_py": ["Zone"],
        "CharlotteFuture2040PolicyMap_py": ["PlaceTypeFullTxt"],
        "Zoning_py": ["ZoneDes", "ZoneClass"],
        "Rezonings_py": ["Petition"],
        "NeighborhoodOrganizationContactList_pt": ["first_name"],
        "ParcelJoin_SingleFam_OwnerOccupied_vpy": ["ParcelID"],
        "CapitalImprovementProjects_vpt": ["Project_Name", "Project_Phase", "Project_Type"],
        "CapitalImprovementProjects_vpy": ["Project_Phase", "Project_Type"],
        "StormWaterCIP_ALL_py": ["ProjName", "ProjStatus", "ProjType"],
        "CECAP_py": ["PRJNAME", "CATEGORY"],
        "CapitalImprovementProjects_vln": ["Project_Name", "Project_Phase"],
        "StrategicInvestmentAreas_py": ["StrategicInvestmentAreaName"],
        "Corridors_of_Opportunity": ["Corridor"],
        "Corridors_AOI": ["Corridor_Name"],
        "CouncilDistricts_py": ["District"],
        "Jurisdictions_py": ["NAME"],
        "StrategicInvestmentAreasPotentialProjects_pt": ["Name", "Type"],
        "StrategicInvestmentAreasPotentialProjects_ln": ["Name", "Type"],
        "WaterQualityBuffers_py": ["DISTANCE", "LEGEND"],
        "Lakes_py": ["NAME"]
      }
    }
  ],
  "tilesets": [
    {
      "id": "core_storm",
      "name": "Core Storm Assets",
      "description": "Stormwater assets, gauges, streams, lakes, buffers, and operational reference layers.",
      "output": "${PORTAL_SHARED_DATA_ROOT}/databases_local/tiles/portal_core_storm.pmtiles",
      "sources": ["spatial-data-warehouse"],
      "includeLayers": [
        "meckcountydams_pt",
        "stormstructure_pt",
        "stormpipes_ln",
        "stormdrainage_ln",
        "ponds_py",
        "stormwatereasements_pt",
        "stormwaterconservationeasements_py",
        "stormwater311requests_pt",
        "stormdrainagerepairprojects_pt",
        "raingauges_pt",
        "streamgauges_pt",
        "streams_ln",
        "waterqualitybuffers_py",
        "lakes_py"
      ],
      "enabled": true
    },
    {
      "id": "property_surfaces",
      "name": "Property and Surfaces",
      "description": "Buildings, parcels, and impervious-surface reference layers.",
      "output": "${PORTAL_SHARED_DATA_ROOT}/databases_local/tiles/portal_property_surfaces.pmtiles",
      "sources": ["spatial-data-warehouse"],
      "includeLayers": [
        "impervioussurfaceother_py",
        "buildings_py",
        "parceljoin_py",
        "impervioussurfacensf_py",
        "impervioussurfacesinglefamily_py",
        "parceljoin_singlefam_owneroccupied_vpy"
      ],
      "enabled": true
    },
    {
      "id": "planning_projects",
      "name": "Planning and Projects",
      "description": "Stormwater projects, land development, planning, zoning, and investment layers.",
      "output": "${PORTAL_SHARED_DATA_ROOT}/databases_local/tiles/portal_planning_projects.pmtiles",
      "sources": ["spatial-data-warehouse"],
      "includeLayers": [
        "stormwaterconstructionprojects_pt",
        "stormwaterprojectstructure_pt",
        "stormwaterprojectpipe_ln",
        "stormwaterprojectchannel_ln",
        "stormwaterprojectparcels_py",
        "stormwaterprojectassignmentzones_py",
        "subdivisions_py",
        "landdevelopment_constructioninspectors_py",
        "landdevelopment_engineeringinspectors_py",
        "landdevelopment_erosioncontrolcoordinators_py",
        "landdevelopmentinspectorareas_py",
        "landdevelopment_planreviewcoordinators",
        "utilitiescoordinationworkzones_py",
        "charlottefuture2040policymap_py",
        "zoning_py",
        "rezonings_py",
        "neighborhoodorganizationcontactlist_pt",
        "capitalimprovementprojects_vpt",
        "capitalimprovementprojects_vpy",
        "stormwatercip_all_py",
        "cecap_py",
        "capitalimprovementprojects_vln",
        "strategicinvestmentareas_py",
        "corridors_of_opportunity",
        "corridors_aoi",
        "councildistricts_py",
        "jurisdictions_py",
        "countyboundary_py",
        "strategicinvestmentareaspotentialprojects_pt",
        "strategicinvestmentareaspotentialprojects_ln"
      ],
      "enabled": true
    },
    {
      "id": "transport_reference",
      "name": "Transportation and Reference",
      "description": "Transportation, transit, floodplain, soils, and topographic reference layers.",
      "output": "${PORTAL_SHARED_DATA_ROOT}/databases_local/tiles/portal_transport_reference.pmtiles",
      "sources": ["spatial-data-warehouse"],
      "includeLayers": [
        "sidewalkinventory_ln",
        "bridgescityinspected_pt",
        "streetsmapuptownadopted_ln",
        "streetsmapadopted_ln",
        "collectorstreets_ln",
        "streetmaintenanceresponsibility_ln",
        "road_ln",
        "lynxblueline_ln",
        "lynxredline_ln",
        "lynxsilverlinealignment_ln",
        "citylynxgoldline_ln",
        "railroad_ln",
        "communityencroachment_py",
        "communityfloodplain_py",
        "femafloodwayencroachment_py",
        "femafloodplain_py",
        "soils_py",
        "topo_ln"
      ],
      "enabled": true
    }
  ]
}
